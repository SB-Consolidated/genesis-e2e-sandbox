{
  "name": "strategic-directive-simple-to-do-app",
  "version": "1.0.0",
  "description": "Single-page local to-do app",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "node scripts/run-stack.mjs --mode=dev",
    "start": "node scripts/run-stack.mjs --mode=prod",
    "server": "node --experimental-strip-types server/server.ts",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.ts",
    "test": "vitest run",
    "quality": "npm run typecheck && npm run lint && npm run build && npm test && npm run ui:e2e",
    "ui:e2e": "playwright test --reporter=line",
    "ui:e2e:headed": "playwright test --headed --reporter=line"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
